# ── OpenRouter ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Model selection (single model used across every node) ────────────────────
LLM_MODEL=anthropic/claude-haiku-4-5      # change to any OpenRouter-supported model

# ── LangSmith (mandatory for demo — enables node-by-node tracing) ────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=fixflow-demo          # project name shown in LangSmith UI
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Luffa Bot Integration ────────────────────────────────────────────────────
LUFFA_SECRET=your_luffa_secret_here
FIXFLOW_BASE_URL=http://localhost:8000

# ── Civic MCP (guardrails + Google Calendar) ───────────────────────────────────
# Bodyguard API key for prompt injection detection.
# If unset, falls back to built-in regex + LLM injection detection.
CIVIC_API_KEY=your_civic_api_key_here

# Civic MCP hub for Google Calendar integration (live availability + booking).
# Create a LangGraph profile at https://app.civic.com and enable Google Calendar.
# If unset, falls back to static/dynamic slot generation.
CIVIC_URL=https://app.civic.com/hub/mcp?accountId=your_account_id&profile=langgraph
CIVIC_TOKEN=your_civic_langgraph_token_here

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
